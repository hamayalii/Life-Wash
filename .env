# Ghasl Service Management System - Database Configuration
# IMPORTANT: Replace the placeholder values below with your actual credentials
# This file should be kept secure and not committed to version control

# PostgreSQL Database Configuration
DB_NAME=ghasl_db
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
PGPASSWORD=CHANGE_THIS_TO_YOUR_SECURE_PASSWORD

# Backup Configuration
BACKUP_DIR=/var/backups/ghasl
RETENTION_DAYS=7
RETENTION_MONTHS=12
